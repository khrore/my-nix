#!/usr/bin/env theme-config-python
"""Update Zed's named desktop theme without changing its linked settings."""

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
sys.dont_write_bytecode = True
from theme_config import run, write_text


def apply_theme(config):
    path = Path(config.settings["settings"]).expanduser()
    if not path.exists():
        return
    metadata = json.loads((config.theme / "apps.json").read_text())
    source = config.theme / "zed.json"
    if not source.exists():
        # Nix extracts this from the same pinned source as the installed Zed.
        source = config.root / "default/zed-gruvbox.json"
    family = json.loads(source.read_text())
    selected = next(
        (theme for theme in family["themes"] if theme["name"] == metadata["zed"]), None
    )
    if selected is None:
        raise ValueError(f"zed.json has no theme named {metadata['zed']}")
    if selected["appearance"] != "dark":
        raise ValueError("Zed's desktop theme must be dark")
    selected["name"] = "Desktop"
    family["name"] = "Desktop"
    family["themes"] = [selected]
    # Zed watches this directory and reloads the fixed-name theme. Do not leave
    # backups here: it also parses those files and can reload the old palette.
    write_text(
        path.parent / "themes/desktop.json",
        json.dumps(family, indent=2) + "\n",
        backup=False,
    )
    print(f"zed: {metadata['zed']}")


if __name__ == "__main__":
    sys.exit(run("zed", apply_theme))
