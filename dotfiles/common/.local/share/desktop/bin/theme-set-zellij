#!/usr/bin/env theme-config-python
"""Update Zellij's named desktop theme without rewriting config.kdl."""

import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
sys.dont_write_bytecode = True
from theme_config import run, write_text


def apply_theme(config):
    path = Path(
        os.environ.get("ZELLIJ_CONFIG_FILE", config.settings["settings"])
    ).expanduser()
    if "ZELLIJ_CONFIG_DIR" in os.environ and "ZELLIJ_CONFIG_FILE" not in os.environ:
        path = Path(os.environ["ZELLIJ_CONFIG_DIR"]) / "config.kdl"
    if not path.exists():
        return
    text = (config.theme / "zellij.kdl").read_text()
    if shutil.which("zellij"):
        # Validate the actual main config plus the generated theme before publishing.
        with tempfile.NamedTemporaryFile(mode="w", suffix=".kdl") as temporary:
            temporary.write(path.read_text() + "\n" + text)
            temporary.flush()
            check = subprocess.run(
                ["zellij", "--config", temporary.name, "setup", "--check"],
                capture_output=True,
                check=False,
                timeout=10,
            )
            if check.returncode:
                raise ValueError("Zellij rejected the generated desktop theme")
    write_text(path.parent / "themes/desktop.kdl", text)
    print("zellij: desktop palette updated")


if __name__ == "__main__":
    sys.exit(run("zellij", apply_theme))
