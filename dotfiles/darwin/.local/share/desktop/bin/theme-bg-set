#!/usr/bin/env theme-config-python
"""Set wallpaper on all connected macOS desktops without changing appearance."""

import hashlib
import os
import subprocess
import sys
from pathlib import Path

if len(sys.argv) != 2 or not Path(sys.argv[1]).is_file():
    sys.exit("Usage: theme-bg-set <path-to-image>")
image = Path(sys.argv[1]).resolve()
wallpaper = image
# Several shared palettes use WebP. Give macOS a native wallpaper format while
# keeping the original image in the cycling state.
if image.suffix.lower() == ".webp":
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    cache = cache / "desktop/wallpapers"
    cache.mkdir(parents=True, exist_ok=True)
    wallpaper = cache / (hashlib.sha256(image.read_bytes()).hexdigest() + ".jpg")
    if not wallpaper.exists():
        temporary_image = wallpaper.with_suffix(".next.jpg")
        try:
            subprocess.run(
                [
                    "sips",
                    "-s",
                    "format",
                    "jpeg",
                    str(image),
                    "--out",
                    str(temporary_image),
                ],
                capture_output=True,
                text=True,
                check=True,
            )
            temporary_image.replace(wallpaper)
        finally:
            temporary_image.unlink(missing_ok=True)
script = """on run argv
    tell application "System Events"
        repeat with desktopItem in desktops
            set picture of desktopItem to (item 1 of argv)
        end repeat
    end tell
end run"""
subprocess.run(["osascript", "-", str(wallpaper)], input=script, text=True, check=True)
root = Path(
    os.environ.get(
        "DESKTOP_ROOT",
        os.environ.get("LINUX_SESSION_ROOT", Path.home() / ".local/share/desktop"),
    )
)
link = root / "current/background"
link.parent.mkdir(parents=True, exist_ok=True)
temporary = link.with_name("background.next")
temporary.unlink(missing_ok=True)
temporary.symlink_to(image)
temporary.replace(link)
