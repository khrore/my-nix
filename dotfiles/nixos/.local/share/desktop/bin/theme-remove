#!/bin/bash

# Remove a user-installed theme by name.
# Usage: theme-remove <theme-name>

if [[ -z $1 ]]; then
  if [[ -d $HOME/.config/desktop/themes ]]; then
    mapfile -t extra_themes < <(find "$HOME/.config/desktop/themes" -mindepth 1 -maxdepth 1 -type d ! -xtype l -printf '%f\n')
  fi

  if (( ${#extra_themes[@]} > 0 )); then
    THEME_NAME=$(printf '%s\n' "${extra_themes[@]}" | sort | gum choose --header="Remove extra theme")
  else
    echo "No extra themes installed."
    exit 1
  fi
else
  THEME_NAME="$1"
fi

THEMES_DIR="$HOME/.config/desktop/themes"
CURRENT_DIR="$HOME/.local/share/desktop/current"
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Ensure a theme was set
if [[ -z $THEME_NAME ]]; then
  exit 1
fi

# Check if theme exists before attempting removal
if [[ ! -d $THEME_PATH ]]; then
  echo "Error: Theme '$THEME_NAME' not found."
  exit 1
fi

# Now remove the theme directory for THEME_NAME
rm -rf "$THEME_PATH"
