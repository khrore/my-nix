#!/usr/bin/env bash
set -euo pipefail
hyprland-eval 'desktop.cycle_scale()'
# Output commits can complete asynchronously, especially on nested compositors.
target=$(hyprctl repl 'desktop.scale_target')
monitor=$(hyprctl repl 'desktop.scale_monitor')
for _ in {1..30}; do
  if hyprctl monitors -j | jq -e --arg name "$monitor" --argjson scale "$target" '.[] | select(.name == $name) | ((.scale - $scale) | fabs) < 0.01' >/dev/null; then
    notify-send "Display scaling set to ${target}x"
    exit 0
  fi
  sleep 0.1
done
if hyprland-eval 'hl.monitor(desktop.scale_previous)'; then
  echo "Monitor did not apply scale ${target}x; restored the previous rule" >&2
else
  echo "Monitor did not apply scale ${target}x; could not restore the previous rule" >&2
fi
exit 1
