#!/bin/bash

# Run the screensaver using random effects from TTE.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "local.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  trap - EXIT SIGINT SIGTERM SIGHUP SIGQUIT
  hyprland-eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || true
  pkill -u "$(id -u)" -x tte 2>/dev/null || true
  pkill -u "$(id -u)" -f '[l]ocal.screensaver' 2>/dev/null || true
}

trap exit_screensaver EXIT
trap 'exit 0' SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007'  # Set background color to black

hyprland-eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null || exit 1

tty=$(tty 2>/dev/null)

while true; do
  tte -i ~/.local/share/desktop/branding/screensaver.txt \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c\
    --random-effect --exclude-effects dev_worm \
    --no-eol --no-restore-cursor &

  while pgrep -t "${tty#/dev/}" -x tte >/dev/null; do
    if read -r -n1 -t 1 || ! screensaver_in_focus; then
      exit 0
    fi
  done
done
