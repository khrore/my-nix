#!/usr/bin/env theme-config-python
"""Apply the desktop palette to Qt apps, including Throne."""

import configparser
import io
import os
import sys
from pathlib import Path

# Shared helpers are linked from the common dotfile layer.
sys.path.insert(
    0,
    str(
        Path(
            os.environ.get(
                "DESKTOP_ROOT",
                os.environ.get(
                    "LINUX_SESSION_ROOT", Path.home() / ".local/share/desktop"
                ),
            )
        )
        / "lib"
    ),
)
sys.dont_write_bytecode = True
from theme_config import notify_once, processes, run, write_text


def apply_theme(config):
    theme, settings = config.theme, config.settings
    state, running, notify = config.state, processes(), config.notify
    source = theme / "qt.colors"
    if not source.exists():
        raise ValueError(
            "Selected theme has no Qt palette; run theme-set to render templates"
        )
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    # qtct uses separate settings for Qt 5 and Qt 6. Keep their palettes together.
    paths = [Path(settings["settings"]).expanduser(), config_home / "qt5ct/qt5ct.conf"]
    for path in paths:
        # qt6ct watches this directory, not just the palette's source directory.
        target = path.parent / "colors/desktop.conf"
        write_text(target, source.read_text())
        parser = configparser.ConfigParser(interpolation=None)
        parser.optionxform = str
        if path.exists():
            parser.read(path)
        if not parser.has_section("Appearance"):
            parser.add_section("Appearance")
        parser["Appearance"].update(
            {
                "style": "Fusion",
                "custom_palette": "true",
                "color_scheme_path": str(target),
            }
        )
        output = io.StringIO()
        parser.write(output, space_around_delimiters=False)
        write_text(path, output.getvalue(), force=True)
    for process in running.get("throne", []):
        try:
            environment = (process / "environ").read_bytes().split(b"\0")
        except OSError:
            continue
        if b"QT_QPA_PLATFORMTHEME=qt6ct" not in environment:
            notify_once(
                state,
                "throne",
                "qt6ct-startup",
                "Throne palette saved. After rebuilding, restart Throne once with its theme set to System.",
                notify,
            )
            break
    print("qt: Qt 5 and Qt 6 palettes updated")


if __name__ == "__main__":
    sys.exit(run("throne", apply_theme))
