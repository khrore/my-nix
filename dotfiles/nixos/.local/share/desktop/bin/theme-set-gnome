#!/usr/bin/env bash
set -euo pipefail

# dconf is also used by Home Manager; no ambient gsettings/schema dependency.
dconf write /org/gnome/desktop/interface/color-scheme "'prefer-dark'"
dconf write /org/gnome/desktop/interface/gtk-theme "'Adwaita-dark'"

SESSION_ROOT=${DESKTOP_ROOT:-${LINUX_SESSION_ROOT:-$HOME/.local/share/desktop}}
GNOME_ICONS_THEME="$SESSION_ROOT/current/theme/icons.theme"
icon_theme="Yaru-blue"
if [[ -f $GNOME_ICONS_THEME ]]; then
  icon_theme=$(<"$GNOME_ICONS_THEME")
fi
# Quote the icon name as a GVariant string.
icon_theme=${icon_theme//\\/\\\\}
icon_theme=${icon_theme//\'/\\\'}
dconf write /org/gnome/desktop/interface/icon-theme "'$icon_theme'"
