{
  "commands": {
    "zen": ["zen"],
    "firefox": ["firefox"],
    "chromium": ["chromium"],
    "pywalfox": ["pywalfox"]
  },
  "zen_profiles": [],
  "chromium_enabled": true,
  "firefox_enabled": true,
  "discover_zen": true,
  "zen_profile_roots": ["~/.config/zen", "~/.zen"],
  "zen_processes": ["zen", "zen-bin"],
  "chromium_refresh_commands": {
    "chromium": ["chromium"],
    "chrome": ["google-chrome"],
    "brave": ["brave"],
    "msedge": ["microsoft-edge"]
  },
  "chromium_policy_paths": [
    "/etc/chromium/policies/managed/linux-desktop-theme.json",
    "/etc/opt/chrome/policies/managed/linux-desktop-theme.json",
    "/etc/brave/policies/managed/linux-desktop-theme.json",
    "/etc/opt/edge/policies/managed/linux-desktop-theme.json"
  ],
  "firefox_profile_roots": [
    {"profiles": "~/.mozilla/firefox", "native_hosts": "~/.mozilla/native-messaging-hosts"},
    {"profiles": "~/.config/mozilla/firefox", "native_hosts": "~/.mozilla/native-messaging-hosts"},
    {"profiles": "~/.config/firefox", "native_hosts": "~/.mozilla/native-messaging-hosts"},
    {"profiles": "~/.librewolf", "native_hosts": "~/.librewolf/native-messaging-hosts"}
  ],
  "firefox_addon_url": "https://addons.mozilla.org/firefox/addon/pywalfox/",
  "notify": true
}
