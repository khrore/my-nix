#!/usr/bin/env theme-config-python
"""Apply the selected desktop theme to codex."""

import hashlib
import json
import os
import sys
from pathlib import Path

import tomlkit

# Resolve the shared helpers beside the script, including when invoked through a dotfile symlink.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
sys.dont_write_bytecode = True
from theme_config import notify_once, processes, run, write_text


def apply_theme(config):
    theme, settings = config.theme, config.settings
    metadata = json.loads((theme / "apps.json").read_text())
    palette = tomlkit.parse((theme / "colors.toml").read_text()).unwrap()
    state, running, notify = config.state, processes(), config.notify
    path = Path(settings["settings"]).expanduser()
    if "CODEX_HOME" in os.environ:
        path = Path(os.environ["CODEX_HOME"]) / "config.toml"
    if not path.exists():
        return
    document = tomlkit.parse(path.read_text())
    desktop = document.setdefault("desktop", tomlkit.table())
    mode = "Dark"
    desktop["appearanceTheme"] = mode.lower()
    desktop[f"appearance{mode}CodeThemeId"] = metadata["codex"]
    key = f"appearance{mode}ChromeTheme"
    chrome = desktop.get(key, tomlkit.table())
    for name, value in {
        "accent": palette["accent"],
        "accentSource": "custom",
        "surface": palette["background"],
        "ink": palette["foreground"],
    }.items():
        chrome[name] = value
    semantic = chrome.get("semanticColors", tomlkit.table())
    semantic.update(
        {
            "diffAdded": palette["color2"],
            "diffRemoved": palette["color1"],
            "skill": palette["color5"],
        }
    )
    if "semanticColors" not in chrome:
        chrome["semanticColors"] = semantic
    if "contrast" not in chrome:
        chrome["contrast"] = 60
    if key not in desktop:
        desktop[key] = chrome
    changed = write_text(path, tomlkit.dumps(document))
    if changed and any(name in running for name in ("codex", "codex-desktop")):
        fingerprint = hashlib.sha256(
            json.dumps([palette, metadata["codex"]], sort_keys=True).encode()
        ).hexdigest()
        notify_once(
            state,
            "codex",
            fingerprint,
            "Codex theme saved. Restart Codex Desktop to apply it to the running app.",
            notify,
        )
    print(f"codex: {metadata['codex']}")


if __name__ == "__main__":
    sys.exit(run("codex", apply_theme))
