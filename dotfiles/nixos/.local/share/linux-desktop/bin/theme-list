#!/bin/bash

{
  if [[ -d $HOME/.config/linux-desktop/themes ]]; then
    find "$HOME/.config/linux-desktop/themes" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  fi
  find "$HOME/.local/share/linux-desktop/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  [[ ! -f $HOME/.config/linux-desktop/themes/$name/light.mode ]] || continue
  [[ ! -f $HOME/.local/share/linux-desktop/themes/$name/light.mode ]] || continue
  # Ignore empty directories left after a managed theme was removed.
  [[ -f $HOME/.config/linux-desktop/themes/$name/colors.toml ||
     -f $HOME/.local/share/linux-desktop/themes/$name/colors.toml ||
     -f $HOME/.config/linux-desktop/themes/$name/hyprland.lua ||
     -f $HOME/.local/share/linux-desktop/themes/$name/hyprland.lua ]] || continue
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
