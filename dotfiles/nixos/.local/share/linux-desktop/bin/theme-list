#!/bin/bash

{
  if [[ -d $HOME/.config/linux-desktop/themes ]]; then
    find "$HOME/.config/linux-desktop/themes" -mindepth 1 -maxdepth 1 \( -type d -o -type l \) -printf '%f\n'
  fi
  find "$HOME/.local/share/linux-desktop/themes/" -mindepth 1 -maxdepth 1 -type d -printf '%f\n'
} | sort -u | while read -r name; do
  echo "$name" | sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g'
done
