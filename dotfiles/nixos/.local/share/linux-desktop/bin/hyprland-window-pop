#!/usr/bin/env bash
# Float, resize, position and pin the captured active window; a second call unpins/tiles it.
# Usage: hyprland-window-pop [width height [x y]]
set -euo pipefail
if (( $# > 4 || $# == 3 )); then
    echo "Usage: hyprland-window-pop [width height [x y]]" >&2
    exit 2
fi
width=${1:-1300}
height=${2:-900}
x=${3:-nil}
y=${4:-nil}
for dimension in "$width" "$height"; do
    [[ $dimension =~ ^[0-9]+$ && $dimension =~ [1-9] ]] || { echo "Size must be a positive integer" >&2; exit 2; }
done
for position in "$x" "$y"; do
    [[ $position == nil || $position =~ ^-?[0-9]+$ ]] || { echo "Position must be an integer" >&2; exit 2; }
done
hyprland-eval "desktop.pop($width, $height, $x, $y)"
