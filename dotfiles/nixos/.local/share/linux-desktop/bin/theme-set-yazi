#!/usr/bin/env theme-config-python
"""Install the desktop palette and reload subscribed Yazi instances."""

import os
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))
sys.dont_write_bytecode = True
from theme_config import run, write_text


def apply_theme(config):
    path = Path(config.settings["settings"]).expanduser()
    if "YAZI_CONFIG_HOME" in os.environ:
        path = Path(os.environ["YAZI_CONFIG_HOME"]) / "theme.toml"
    write_text(path, (config.theme / "yazi.toml").read_text())
    if shutil.which("ya"):
        # DDS receiver 0 broadcasts to subscribers, without guessing instance IDs.
        result = subprocess.run(
            ["ya", "pub-to", "0", "desktop-theme", "--str", "reload"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
        # No running subscriber is normal, including before the first restart.
        if result.returncode and not any(
            message in result.stderr
            for message in ("No running", "Connection refused", "No such file")
        ):
            print(f"yazi: palette saved; live reload: {result.stderr.strip()}")
    print("yazi: desktop palette updated")


if __name__ == "__main__":
    sys.exit(run("yazi", apply_theme))
