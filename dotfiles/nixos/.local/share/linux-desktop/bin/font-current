#!/usr/bin/env bash
# Read the selected monospace font, independently of the shell UI font.
set -euo pipefail
exec theme-config-python - <<'PY'
import os
from pathlib import Path
import xml.etree.ElementTree as ET

config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
tree = ET.parse(config / "fontconfig/fonts.conf")
node = next((match.find("edit/string") for match in tree.findall("match")
             if match.findtext("test/string") == "monospace"), None)
if node is None or not node.text:
    raise SystemExit("No monospace font setting in fontconfig/fonts.conf")
print(node.text)
PY
