# Changes require a restart to take effect.

# Ensure desktop helper bins are in the path
export LINUX_SESSION_ROOT=$HOME/.local/share/linux-desktop
export PATH=$HOME/.local/bin:$LINUX_SESSION_ROOT/bin:$PATH

# Set default terminal and editor
source ~/.config/uwsm/default

# Proxy for UWSM-managed applications.
export HTTP_PROXY="http://127.0.0.1:2080"
export HTTPS_PROXY="$HTTP_PROXY"
export NO_PROXY="localhost,127.0.0.1,::1"

# Activate mise if present on the system
command-present mise && eval "$(mise activate bash --shims)"

# Toolkit and cursor settings shared by UWSM-managed applications.
export XCURSOR_SIZE=24
export GDK_BACKEND='wayland,x11,*'
export QT_QPA_PLATFORM='wayland;xcb'
# Qt platform theme and style come from Home Manager.
export SDL_VIDEODRIVER='wayland,x11'
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
export OZONE_PLATFORM=wayland
export XCOMPOSEFILE="$HOME/.XCompose"
export GDK_SCALE=1
export GUM_CONFIRM_PROMPT_FOREGROUND=6
export GUM_CONFIRM_SELECTED_FOREGROUND=0
export GUM_CONFIRM_SELECTED_BACKGROUND=2
export GUM_CONFIRM_UNSELECTED_FOREGROUND=7
export GUM_CONFIRM_UNSELECTED_BACKGROUND=8
