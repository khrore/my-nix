# Changes require a restart to take effect.

# Ensure desktop helper bins are in the path
export LINUX_SESSION_ROOT=$HOME/.local/share/linux-desktop
export PATH=$HOME/.local/bin:$LINUX_SESSION_ROOT/bin:$PATH

# Set default terminal and editor
source ~/.config/uwsm/default

# Activate mise if present on the system
command-present mise && eval "$(mise activate bash --shims)"
